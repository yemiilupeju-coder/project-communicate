/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=()
  # Cross-origin isolation lets the child-voice maker use several threads
  # (about twice as fast). The app loads nothing from other sites.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The service worker and manifest must always be checked for updates.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Vite file names include a content hash, so these never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/voices/*
  Cache-Control: public, max-age=31536000, immutable
